  <data key="d14">Michael Dinitz</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/27/2346</data>
</node>
<node id="Guy Even">
  <data key="d14">Guy Even</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/45/1790</data>
</node>
<node id="Martin Haenggi">
  <data key="d14">Martin Haenggi</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/49/3683</data>
</node>
<node id="Stephan Holzer">
  <data key="d14">Stephan Holzer</data>
  <data key="d0">person</data>
