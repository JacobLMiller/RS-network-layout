<node id="Corina Sas">
  <data key="d14">Corina Sas</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/64/5059</data>
</node>
<node id="Katrin Wolf">
  <data key="d14">Katrin Wolf</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/19/1694-1</data>
