  <data key="d14">Felix Ingrand</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/i/FelixIngrand</data>
</node>
<node id="Lars Kunze">
  <data key="d14">Lars Kunze</data>
  <data key="d0">person</data>
