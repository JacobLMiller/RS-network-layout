</node>
<node id="Mary Ann Blätke">
  <data key="d14">Mary Ann Blätke</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/34/10894</data>
</node>
<node id="Maciej Dobrzynski">
  <data key="d14">Maciej Dobrzynski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/58/914</data>
</node>
<node id="Mostafa Herajy">
  <data key="d14">Mostafa Herajy</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/32/11488</data>
</node>
<node id="Pietro Lio">
  <data key="d14">Pietro Lio</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/l/PietroLio</data>
</node>
<node id="Fei Liu">
  <data key="d14">Fei Liu</data>
  <data key="d0">person</data>
