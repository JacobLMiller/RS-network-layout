  <data key="d12">Computability and complexity; combinatorial problems; reducibilities; computational complexity; reverse and constructive mathematics</data>
  <data key="d13">15392; 25131</data>
</node>
<node id="Merlin Carl">
  <data key="d14">Merlin Carl</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/04/8629</data>
</node>
<node id="Jun Le Goh">
  <data key="d14">Jun Le Goh</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/260/8051</data>
</node>
<node id="Mathieu Hoyrup">
  <data key="d14">Mathieu Hoyrup</data>
  <data key="d0">person</data>
