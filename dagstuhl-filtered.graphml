</node>
<node id="Silvia Tozza">
  <data key="d14">Silvia Tozza</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/141/3795</data>
</node>
<node id="Matthias Vestner">
  <data key="d14">Matthias Vestner</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/151/8864</data>
</node>
<node id="Hao (Richard) Zhang">
  <data key="d14">Hao (Richard) Zhang</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/z/HaoZhang2</data>
