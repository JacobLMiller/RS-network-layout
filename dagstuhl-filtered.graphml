<node id="Laurens Sion">
  <data key="d14">Laurens Sion</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/166/1069</data>
</node>
<node id="Matthew Smith">
  <data key="d14">Matthew Smith</data>
  <data key="d0">person</data>
