<node id="Christoph Stiller">
  <data key="d14">Christoph Stiller</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/83/1803</data>
</node>
<node id="Ruigang Yang">
  <data key="d14">Ruigang Yang</data>
  <data key="d0">person</data>
