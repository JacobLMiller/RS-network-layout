</node>
<node id="Gabriele Röger">
  <data key="d14">Gabriele Röger</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/92/2559</data>
</node>
<node id="Yanjing Wang">
  <data key="d14">Yanjing Wang</data>
