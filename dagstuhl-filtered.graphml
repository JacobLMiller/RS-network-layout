</node>
<node id="Emad Shihab">
  <data key="d14">Emad Shihab</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/05/5996</data>
</node>
<node id="Diomidis Spinellis">
  <data key="d14">Diomidis Spinellis</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/DiomidisSpinellis</data>
