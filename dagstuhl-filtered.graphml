<node id="Themis Palpanas">
  <data key="d14">Themis Palpanas</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/p/ThemisPalpanas</data>
</node>
<node id="Sherif Sakr">
  <data key="d14">Sherif Sakr</data>
  <data key="d0">person</data>
