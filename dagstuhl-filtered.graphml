</node>
<node id="Anna Volossovitch">
  <data key="d14">Anna Volossovitch</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/04/11023</data>
</node>
<node id="Markus Wagner">
  <data key="d14">Markus Wagner</data>
  <data key="d0">person</data>
