</node>
<node id="Jan Pich">
  <data key="d14">Jan Pich</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/67/8727</data>
</node>
<node id="Dmitry Sokolov">
  <data key="d14">Dmitry Sokolov</data>
  <data key="d0">person</data>
