                        Creative Commons BY 3.0 Unported license
                    &lt;/a&gt;
&lt;/div&gt; 
 &lt;div&gt;
&lt;img alt="Copyright" src="https://www.dagstuhl.de/_Resources/Static/Packages/Dagstuhl.Site/Frontend/images/licenses/copy.png?bust=22575bbf" style="width: 1em;"/&gt;

                    Jialin Liu, Tom Schaul, Pieter Spronck, and Julian Togelius
                &lt;/div&gt; 
</data>
  <data key="d9">https://dx.doi.org/10.3233/ICG-200170; https://doi.org/10.1109/CIG.2019.8848032; https://arxiv.org/abs/2004.01703; https://doi.org/10.1109/SSCI47803.2020.9308363; https://doi.org/10.1109/CIG.2019.8848021; https://doi.org/10.1109/CEC48606.2020.9185654; https://doi.org/10.1109/CIG.2019.8848067; https://doi.org/10.1109/CIG.2019.8847990</data>
