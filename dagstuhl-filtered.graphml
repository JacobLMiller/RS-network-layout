  <data key="d14">Duc-Cuong Dang</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/19/6577</data>
</node>
<node id="Piyush Srivastava">
  <data key="d14">Piyush Srivastava</data>
  <data key="d0">person</data>
