  <data key="d14">Dick De Jongh</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/89/1830</data>
</node>
<node id="Aaron M. Hunter">
  <data key="d14">Aaron M. Hunter</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
