</node>
<node id="Ilia Ponomarenko">
  <data key="d14">Ilia Ponomarenko</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/65/3859</data>
</node>
<node id="Vladimir Shpilrain">
  <data key="d14">Vladimir Shpilrain</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/78/1532</data>
