</node>
<node id="Ronald Schroeter">
  <data key="d14">Ronald Schroeter</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/66/5901</data>
</node>
<node id="Bruce N. Walker">
  <data key="d14">Bruce N. Walker</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/w/BruceNWalker</data>
