  <data key="d14">Bernd Hellingrath</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/62/4228</data>
</node>
<node id="Thorsten Quandt">
  <data key="d14">Thorsten Quandt</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/52/9459</data>
