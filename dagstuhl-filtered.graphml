</node>
<node id="Janis Voigtländer">
  <data key="d14">Janis Voigtländer</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/v/JanisVoigtlander</data>
</node>
<node id="Yingfei Xiong">
  <data key="d14">Yingfei Xiong</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/82/2673</data>
</node>
<node id="Tetsuo Yokoyama">
  <data key="d14">Tetsuo Yokoyama</data>
