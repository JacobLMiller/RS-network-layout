<node id="Xujie Si">
  <data key="d14">Xujie Si</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/142/8449</data>
</node>
<node id="Zsolt Zombori">
  <data key="d14">Zsolt Zombori</data>
  <data key="d0">person</data>
