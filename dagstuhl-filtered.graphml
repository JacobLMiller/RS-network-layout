<node id="Christian Schindelhauer">
  <data key="d14">Christian Schindelhauer</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/ChristianSchindelhauer</data>
</node>
<node id="Anita Schöbel">
  <data key="d14">Anita Schöbel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/09/3739</data>
</node>
