  <data key="d14">Claus-Christian Carbon</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/91/3313</data>
</node>
<node id="Mauro Martino">
  <data key="d14">Mauro Martino</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/50/7848</data>
</node>
