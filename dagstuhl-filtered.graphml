</node>
<node id="Tilmann Rabl">
  <data key="d14">Tilmann Rabl</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/10/760</data>
</node>
<node id="Thomas Weise">
  <data key="d14">Thomas Weise</data>
  <data key="d0">person</data>
