  <data key="d11">data structures / algorithms / complexity</data>
  <data key="d12">computational topology; topological data analysis</data>
  <data key="d13">19212; 23192</data>
</node>
<node id="Roxana Bujack">
  <data key="d14">Roxana Bujack</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/132/9412</data>
</node>
