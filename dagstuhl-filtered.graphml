  <data key="d11">hardware; semantics / formal methods; society / human-computer interaction</data>
  <data key="d12">Semantic sensor networks; Web of Things; Internet of Things; semantic interoperability and context; social computing; collective intelligence; situation-awareness; human and machine perception; computing for human experience; social life networks; da</data>
  <data key="d13"></data>
</node>
<node id="Edward Curry">
  <data key="d14">Edward Curry</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/60/2291</data>
</node>
