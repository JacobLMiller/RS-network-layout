</node>
<node id="Éric Tanter">
  <data key="d14">Éric Tanter</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/t/EricTanter</data>
</node>
<node id="Sam Tobin-Hochstadt">
  <data key="d14">Sam Tobin-Hochstadt</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/56/3287</data>
</node>
<node id="Francesco Zappa Nardelli">
  <data key="d14">Francesco Zappa Nardelli</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/z/FrancescoZappaNardelli</data>
