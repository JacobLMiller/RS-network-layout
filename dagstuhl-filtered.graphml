  <data key="d14">Husain Aljazzar</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Cyrille Artho">
  <data key="d14">Cyrille Artho</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/21/6330</data>
</node>
<node id="Dragan Bosnacki">
  <data key="d14">Dragan Bosnacki</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/38/2132</data>
</node>
<node id="Klaus Dräger">
  <data key="d14">Klaus Dräger</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
