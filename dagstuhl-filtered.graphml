</node>
<node id="Ely Porat">
  <data key="d14">Ely Porat</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/02/836</data>
</node>
<node id="Anatoly Zhigljavsky">
  <data key="d14">Anatoly Zhigljavsky</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/60/5453</data>
