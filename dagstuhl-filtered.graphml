  <data key="d14">Cristina Conati</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/34/5056</data>
</node>
<node id="Hector Geffner">
  <data key="d14">Hector Geffner</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/g/HectorGeffner</data>
</node>
<node id="Peter Kiefer">
  <data key="d14">Peter Kiefer</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/95/1990</data>
