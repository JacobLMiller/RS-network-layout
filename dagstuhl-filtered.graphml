</node>
<node id="Luke Bornn">
  <data key="d14">Luke Bornn</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/125/2287</data>
</node>
<node id="Laura de Jong">
  <data key="d14">Laura de Jong</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Uwe Dick">
  <data key="d14">Uwe Dick</data>
  <data key="d0">person</data>
