<node id="Alexander Sorkine-Hornung">
  <data key="d14">Alexander Sorkine-Hornung</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/46/4142</data>
</node>
<node id="Olga Sorkine-Hornung">
  <data key="d14">Olga Sorkine-Hornung</data>
  <data key="d0">person</data>
