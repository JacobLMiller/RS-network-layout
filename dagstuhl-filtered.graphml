<node id="James Kapinski">
  <data key="d14">James Kapinski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/27/532</data>
</node>
<node id="Jens Oehlerking">
  <data key="d14">Jens Oehlerking</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/87/1596</data>
</node>
<node id="Matthias Rungger">
  <data key="d14">Matthias Rungger</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/10/7278</data>
</node>
<node id="Paulo Tabuada">
  <data key="d14">Paulo Tabuada</data>
  <data key="d0">person</data>
