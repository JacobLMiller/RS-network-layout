  <data key="d11">networks; security / cryptology; society / human-computer interaction</data>
  <data key="d12">privacy; distributed systems; social networks</data>
  <data key="d13"></data>
</node>
<node id="Artur Hecker">
  <data key="d14">Artur Hecker</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/36/640</data>
</node>
<node id="Urs Hengartner">
  <data key="d14">Urs Hengartner</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/04/6136</data>
</node>
<node id="Balachander Krishnamurthy">
  <data key="d14">Balachander Krishnamurthy</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/89/7016</data>
</node>
<node id="Stefanie Roos">
  <data key="d14">Stefanie Roos</data>
