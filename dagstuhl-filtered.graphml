</node>
<node id="Thomas Herault">
  <data key="d14">Thomas Herault</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/78/3532</data>
</node>
<node id="Guillaume Huard">
  <data key="d14">Guillaume Huard</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Emmanuel Jeannot">
  <data key="d14">Emmanuel Jeannot</data>
  <data key="d0">person</data>
