  <data key="d10">https://doi.org/10.4230/DagRep.1.7.53</data>
  <data key="d11">artificial intelligence; algorithms; optimization</data>
  <data key="d12">learning theory; machine learning; sparsity; high-dimensional geometry; manifold learning; online learning; reinforcement learning</data>
