</node>
<node id="Ellen Yi-Luen Do">
  <data key="d14">Ellen Yi-Luen Do</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/d/EllenYiLuenDo</data>
</node>
<node id="Michal Rinott">
  <data key="d14">Michal Rinott</data>
  <data key="d0">person</data>
