</node>
<node id="Harish Doraiswamy">
  <data key="d14">Harish Doraiswamy</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/05/264</data>
</node>
<node id="Michael Lesnick">
  <data key="d14">Michael Lesnick</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/03/9829</data>
</node>
<node id="Steve Y. Oudot">
  <data key="d14">Steve Y. Oudot</data>
  <data key="d0">person</data>
