  <data key="d11">artificial intelligence / robotics; data bases / information retrieval; data structures / algorithms / complexity</data>
  <data key="d12">Parallel machine learning; parallel data processing; data mining; software frameworks; storage and database systems</data>
  <data key="d13"></data>
</node>
<node id="Sebastian Breß">
  <data key="d14">Sebastian Breß</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/25/11440</data>
</node>
