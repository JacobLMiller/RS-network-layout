<node id="Christian Tominski">
  <data key="d14">Christian Tominski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/t/ChristianTominski</data>
</node>
<node id="Xiaoru Yuan">
  <data key="d14">Xiaoru Yuan</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/36/2050</data>
