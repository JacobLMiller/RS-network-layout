  <data key="d9">https://arxiv.org/abs/2204.11495; https://arxiv.org/abs/2210.05019; https://arxiv.org/abs/2210.05019; https://arxiv.org/abs/2208.12548; https://doi.org/10.1007/978-3-031-23101-8_8</data>
  <data key="d10">https://doi.org/10.4230/DagRep.11.6.82</data>
