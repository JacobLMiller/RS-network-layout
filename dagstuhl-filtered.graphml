</node>
<node id="Michael Elberfeld">
  <data key="d14">Michael Elberfeld</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/17/3221</data>
</node>
<node id="Or Meir">
  <data key="d14">Or Meir</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/26/2656</data>
