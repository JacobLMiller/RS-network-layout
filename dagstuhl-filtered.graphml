  <data key="d14">Leonardo A. Martucci</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/12/3968</data>
</node>
<node id="Jos Weyers">
  <data key="d14">Jos Weyers</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Wenyuan Xu">
  <data key="d14">Wenyuan Xu</data>
