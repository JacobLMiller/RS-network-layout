<node id="Michael Lampis">
  <data key="d14">Michael Lampis</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/88/6157</data>
</node>
<node id="Michael Raskin">
  <data key="d14">Michael Raskin</data>
  <data key="d0">person</data>
