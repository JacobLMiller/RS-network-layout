</node>
<node id="Kenneth G. Paterson">
  <data key="d14">Kenneth G. Paterson</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/39/780</data>
</node>
<node id="Carsten Rudolph">
