                        Creative Commons BY 3.0 Unported license
                    &lt;/a&gt;
&lt;/div&gt; 
 &lt;div&gt;
&lt;img alt="Copyright" src="https://www.dagstuhl.de/_Resources/Static/Packages/Dagstuhl.Site/Frontend/images/licenses/copy.png?bust=22575bbf" style="width: 1em;"/&gt;

                    Emmanuel Filiot, Sebastian Maneth, and Helmut Seidl
                &lt;/div&gt; 
</data>
  <data key="d9">https://doi.org/10.1007/s00224-015-9660-2; https://doi.org/10.1016/j.tcs.2018.03.014</data>
  <data key="d10">https://doi.org/10.4230/DagRep.7.4.23</data>
