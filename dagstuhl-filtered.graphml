<node id="Bernhard Thomaszewski">
  <data key="d14">Bernhard Thomaszewski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/10/4815</data>
</node>
<node id="Nobuyuki Umetani">
  <data key="d14">Nobuyuki Umetani</data>
  <data key="d0">person</data>
