  <data key="d14">Charles Anthony Richard Hoare</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/h/CARHoare</data>
</node>
<node id="Alexei Iliasov">
  <data key="d14">Alexei Iliasov</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/11/4579</data>
</node>
<node id="Ralf Schenkel">
  <data key="d14">Ralf Schenkel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/RalfSchenkel</data>
</node>
