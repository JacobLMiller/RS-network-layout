</node>
<node id="Kobi Gal">
  <data key="d14">Kobi Gal</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/65/3114</data>
</node>
<node id="Samuel Mascarenhas">
  <data key="d14">Samuel Mascarenhas</data>
