<node id="Shikha Singh">
  <data key="d14">Shikha Singh</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/124/3768-2</data>
</node>
<node id="Przemyslaw Uznanski">
  <data key="d14">Przemyslaw Uznanski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/78/11210</data>
