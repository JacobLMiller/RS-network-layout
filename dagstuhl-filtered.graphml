  <data key="d10">https://doi.org/10.4230/DagRep.5.4.56</data>
  <data key="d11">modelling / simulation; programming languages / compiler; software engineering</data>
  <data key="d12">stencil codes; architectural metaprogramming; linear solvers; multigrid methods; supercomputing; software engineering; massive parallelism</data>
  <data key="d13"></data>
</node>
<node id="Mauro Bianco">
  <data key="d14">Mauro Bianco</data>
