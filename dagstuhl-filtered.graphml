  <data key="d14">Quoc Sang Phan</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/30/9676</data>
</node>
<node id="Geoffrey Smith">
  <data key="d14">Geoffrey Smith</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/36/2470</data>
</node>
<node id="Tachio Terauchi">
  <data key="d14">Tachio Terauchi</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/96/889</data>
</node>
<node id="Carmela Troncoso">
  <data key="d14">Carmela Troncoso</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/01/4825</data>
