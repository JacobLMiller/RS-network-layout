<node id="Pierre Senellart">
  <data key="d14">Pierre Senellart</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/12/225</data>
</node>
<node id="Martin Theobald">
  <data key="d14">Martin Theobald</data>
