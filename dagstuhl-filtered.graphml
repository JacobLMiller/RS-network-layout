<node id="Dieter Schmalstieg">
  <data key="d14">Dieter Schmalstieg</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/DieterSchmalstieg</data>
</node>
<node id="Kristof Van Laerhoven">
  <data key="d14">Kristof Van Laerhoven</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/61/5730</data>
