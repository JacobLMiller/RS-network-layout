<node id="Dietrich Klakow">
  <data key="d14">Dietrich Klakow</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/00/1846</data>
</node>
<node id="Carina Silberer">
  <data key="d14">Carina Silberer</data>
  <data key="d0">person</data>
