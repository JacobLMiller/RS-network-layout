  <data key="d14">Jacob Focke</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/202/1955</data>
</node>
<node id="Andreas Galanis">
  <data key="d14">Andreas Galanis</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/16/9673</data>
</node>
<node id="John Lapinskas">
  <data key="d14">John Lapinskas</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/129/4847</data>
</node>
<node id="Sarah Miracle">
  <data key="d14">Sarah Miracle</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/52/9962</data>
</node>
<node id="Viresh Patel">
  <data key="d14">Viresh Patel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/33/2410</data>
