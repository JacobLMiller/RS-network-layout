</node>
<node id="Aleksandar Nikolov">
  <data key="d14">Aleksandar Nikolov</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/24/7867</data>
</node>
<node id="Zuzana Patáková">
  <data key="d14">Zuzana Patáková</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/163/1849</data>
</node>
<node id="Benjamin Raichel">
  <data key="d14">Benjamin Raichel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/96/9733</data>
</node>
<node id="André van Renssen">
  <data key="d14">André van Renssen</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/21/8434</data>
</node>
<node id="Bei Wang Phillips">
  <data key="d14">Bei Wang Phillips</data>
