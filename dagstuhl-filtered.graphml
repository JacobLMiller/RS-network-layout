  <data key="d14">Serge Gaspers</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/33/5862</data>
</node>
<node id="Pinar Heggernes">
  <data key="d14">Pinar Heggernes</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/96/4012</data>
</node>
<node id="Christian Hundt">
  <data key="d14">Christian Hundt</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Mathieu Liedloff">
  <data key="d14">Mathieu Liedloff</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/53/644</data>
