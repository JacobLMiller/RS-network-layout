</node>
<node id="Yannick Rudolph">
  <data key="d14">Yannick Rudolph</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/233/9956</data>
</node>
<node id="Maaike Van Roy">
  <data key="d14">Maaike Van Roy</data>
