<node id="Maria Prandini">
  <data key="d14">Maria Prandini</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/01/654</data>
</node>
<node id="Armando Tacchella">
  <data key="d14">Armando Tacchella</data>
  <data key="d0">person</data>
