<node id="John Quarles">
  <data key="d14">John Quarles</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/52/1010</data>
</node>
<node id="Jeanine Stefanucci">
  <data key="d14">Jeanine Stefanucci</data>
