<node id="Antti-Juhani Kaijanaho">
  <data key="d14">Antti-Juhani Kaijanaho</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/91/3083</data>
</node>
<node id="Gail C. Murphy">
  <data key="d14">Gail C. Murphy</data>
  <data key="d0">person</data>
