<node id="Mehdi B. Tahoori">
  <data key="d14">Mehdi B. Tahoori</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/55/3589</data>
</node>
<node id="Shigeru Yamashita">
  <data key="d14">Shigeru Yamashita</data>
