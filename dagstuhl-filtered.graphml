  <data key="d14">Dimitra Giannakopoulou</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/39/117</data>
</node>
<node id="Moa Johansson">
  <data key="d14">Moa Johansson</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/02/452</data>
</node>
<node id="Ekaterina Komendantskaya">
  <data key="d14">Ekaterina Komendantskaya</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/62/4310</data>
</node>
<node id="Thierry Lecomte">
  <data key="d14">Thierry Lecomte</data>
  <data key="d0">person</data>
