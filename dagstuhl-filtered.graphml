  <data key="d10">https://drops.dagstuhl.de/opus/portals/index.php?semnr=07351</data>
  <data key="d11">artificial intelligence / robotics; interdisciplinary with non-informatics-topic: Economics; Decision Theory; Philosophy</data>
  <data key="d12">belief change; rational agents; information economy; information processing</data>
  <data key="d13">05321; 09351</data>
</node>
