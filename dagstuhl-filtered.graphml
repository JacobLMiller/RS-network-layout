  <data key="d10">https://doi.org/10.4230/DagRep.4.9.1</data>
  <data key="d11">modelling / simulation</data>
  <data key="d12">continuous adjoints; discrete adjoints; high-performance scientific computing; algorithmic differentiation</data>
