</node>
<node id="Maximilian Ott">
  <data key="d14">Maximilian Ott</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/83/6438</data>
</node>
<node id="Ellen Zegura">
  <data key="d14">Ellen Zegura</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/z/EllenWZegura</data>
