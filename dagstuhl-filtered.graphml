  <data key="d10">https://doi.org/10.4230/DagRep.7.7.110</data>
  <data key="d11">data bases / information retrieval; multimedia; world wide web / internet</data>
  <data key="d12">Social media; information extraction; multimedia retrieval and annotation; trend detection; e-reputation</data>
