  <data key="d10">https://doi.org/10.4230/DagRep.11.5.76</data>
  <data key="d11">data structures / algorithms / complexity</data>
  <data key="d12">Quantum computation; complexity theory; many-body systems; proof and verification systems; quantum supremacy</data>
