  <data key="d14">Oliver Diessel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/12/3779</data>
</node>
<node id="Diana Göhringer">
  <data key="d14">Diana Göhringer</data>
  <data key="d0">person</data>
