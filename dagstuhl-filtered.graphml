  <data key="d14">Leif Azzopardi</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/29/4018</data>
</node>
<node id="Tim Gollub">
  <data key="d14">Tim Gollub</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/17/10440</data>
