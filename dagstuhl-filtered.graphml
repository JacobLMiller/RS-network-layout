</node>
<node id="Paul Bogdan">
  <data key="d14">Paul Bogdan</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/05/5539</data>
</node>
<node id="Alexandre Donzé">
  <data key="d14">Alexandre Donzé</data>
  <data key="d0">person</data>
