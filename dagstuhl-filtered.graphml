<node id="Josef van Genabith">
  <data key="d14">Josef van Genabith</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/82/3447</data>
</node>
<node id="Martin Volk">
  <data key="d14">Martin Volk</data>
  <data key="d0">person</data>
