<node id="Michalis Famelis">
  <data key="d14">Michalis Famelis</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/82/11109</data>
</node>
<node id="Steven Kelly">
  <data key="d14">Steven Kelly</data>
