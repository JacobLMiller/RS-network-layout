</node>
<node id="Gabriele Varani">
  <data key="d14">Gabriele Varani</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/19/11001</data>
</node>
<node id="Gene Yeo">
  <data key="d14">Gene Yeo</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/00/1202</data>
