<node id="Gloria Mark">
  <data key="d14">Gloria Mark</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/17/1744</data>
</node>
<node id="Isabelle Reymen">
  <data key="d14">Isabelle Reymen</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="William N. Robinson">
  <data key="d14">William N. Robinson</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Matti Rossi">
