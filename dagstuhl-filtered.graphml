<node id="Thidapat (Tam) Chantem">
  <data key="d14">Thidapat (Tam) Chantem</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/59/2918</data>
</node>
<node id="Mitra Nasri">
  <data key="d14">Mitra Nasri</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/58/7582</data>
</node>
<node id="Claire Pagetti">
  <data key="d14">Claire Pagetti</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/83/6391</data>
</node>
<node id="Philippa Ryan">
  <data key="d14">Philippa Ryan</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/01/246</data>
