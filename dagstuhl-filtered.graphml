<node id="Jonathan Grudin">
  <data key="d14">Jonathan Grudin</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/g/JonathanGrudin</data>
</node>
<node id="Douglas B. Terry">
