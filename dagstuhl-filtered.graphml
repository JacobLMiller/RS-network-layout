  <data key="d14">Klaus Havelund</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/84/3029</data>
</node>
<node id="Kim Guldstrand Larsen">
  <data key="d14">Kim Guldstrand Larsen</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/l/KimGuldstrandLarsen</data>
</node>
<node id="Grigore Rosu">
  <data key="d14">Grigore Rosu</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/r/GrigoreRosu</data>
</node>
<node id="Sriram Sankaranarayanan">
  <data key="d14">Sriram Sankaranarayanan</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/82/1542</data>
</node>
<node id="Volker Stolz">
  <data key="d14">Volker Stolz</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/24/2502</data>
</node>
<node id="Serdar Tasiran">
  <data key="d14">Serdar Tasiran</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/88/1444</data>
</node>
<node id="Claus Thrane">
  <data key="d14">Claus Thrane</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Stavros Tripakis">
