  <data key="d14">Gabriele Peters</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/p/GabrielePeters</data>
</node>
<node id="Ingo Scholtes">
  <data key="d14">Ingo Scholtes</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/IngoScholtes</data>
