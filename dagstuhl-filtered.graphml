<node id="Roderick Murray-Smith">
  <data key="d14">Roderick Murray-Smith</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/78/604</data>
</node>
<node id="Daniele Panozzo">
  <data key="d14">Daniele Panozzo</data>
  <data key="d0">person</data>
