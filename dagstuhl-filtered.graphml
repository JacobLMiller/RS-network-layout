</node>
<node id="Gerard J. M. Smit">
  <data key="d14">Gerard J. M. Smit</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/s/GerardJMSmit</data>
</node>
<node id="Walter Stechele">
  <data key="d14">Walter Stechele</data>
  <data key="d0">person</data>
  <data key="d15"></data>
