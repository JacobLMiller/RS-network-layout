  <data key="d10">https://doi.org/10.4230/DagRep.9.8.26</data>
  <data key="d11">data structures / algorithms / complexity</data>
  <data key="d12">tractability analysis; computational stochastics; computing and complexity in infinite dimensions; discrepancy theory; applied harmonic analysis</data>
