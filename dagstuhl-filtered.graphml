  <data key="d14">Henri Prade</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/p/HenriPrade</data>
</node>
<node id="Steven Schockaert">
  <data key="d14">Steven Schockaert</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/29/3972</data>
</node>
<node id="Renata Wassermann">
  <data key="d14">Renata Wassermann</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/w/RenataWassermann</data>
