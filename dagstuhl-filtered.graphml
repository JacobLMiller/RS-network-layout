</node>
<node id="Oliver Schneider">
  <data key="d14">Oliver Schneider</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/264/7134</data>
</node>
<node id="Orit Shaer">
  <data key="d14">Orit Shaer</data>
  <data key="d0">person</data>
