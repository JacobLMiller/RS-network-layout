<node id="Thomas Thüm">
  <data key="d14">Thomas Thüm</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/04/7056</data>
</node>
<node id="Janet Siegmund">
  <data key="d14">Janet Siegmund</data>
  <data key="d0">person</data>
