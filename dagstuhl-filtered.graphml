<node id="Victor Dalmau">
  <data key="d14">Victor Dalmau</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/96/696</data>
</node>
<node id="Josep Diaz">
  <data key="d14">Josep Diaz</data>
  <data key="d0">person</data>
  <data key="d15"></data>
