</node>
<node id="Soo Young Rieh">
  <data key="d14">Soo Young Rieh</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/92/799</data>
</node>
<node id="Max L. Wilson">
  <data key="d14">Max L. Wilson</data>
  <data key="d0">person</data>
