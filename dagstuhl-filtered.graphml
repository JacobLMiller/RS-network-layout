  <data key="d14">Emma Hart</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/95/3951</data>
</node>
<node id="Alan FT Winfield">
  <data key="d14">Alan FT Winfield</data>
  <data key="d0">person</data>
