  <data key="d14">Jan Peters</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/p/JanPeters1</data>
</node>
<node id="Jürgen Sturm">
  <data key="d14">Jürgen Sturm</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/74/1616</data>
</node>
