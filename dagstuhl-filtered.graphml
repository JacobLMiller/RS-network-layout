</node>
<node id="David F. Gleich">
  <data key="d14">David F. Gleich</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/40/4457</data>
</node>
<node id="Boulos Harb">
  <data key="d14">Boulos Harb</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Stephen Kirkland">
  <data key="d14">Stephen Kirkland</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/04/1508</data>
</node>
<node id="Udo Krieger">
  <data key="d14">Udo Krieger</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/22/4058</data>
</node>
<node id="Beatrice Meini">
  <data key="d14">Beatrice Meini</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="Tamás Sarlós">
  <data key="d14">Tamás Sarlós</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/48/959</data>
</node>
<node id="Bora Uçar">
  <data key="d14">Bora Uçar</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/54/6400</data>
</node>
<node id="Sascha Hunold">
  <data key="d14">Sascha Hunold</data>
