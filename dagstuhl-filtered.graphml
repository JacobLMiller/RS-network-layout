<node id="Viktor Winschel">
  <data key="d14">Viktor Winschel</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/120/7687</data>
</node>
<node id="Glynn Winskel">
  <data key="d14">Glynn Winskel</data>
