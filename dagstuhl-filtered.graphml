<node id="11391">
  <data key="d0">event</data>
  <data key="d1">11391</data>
  <data key="d2">Dagstuhl Seminar</data>
  <data key="d3">Public-Key Cryptography</data>
  <data key="d4">2011-09-25</data>
  <data key="d5">2011-09-30</data>
