</node>
<node id="Wojciech Mostowski">
  <data key="d14">Wojciech Mostowski</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/71/6269</data>
</node>
<node id="Mattias Ulbrich">
