</node>
<node id="Claes Strannegård">
  <data key="d14">Claes Strannegård</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/33/4624</data>
</node>
<node id="Christina Zeller">
  <data key="d14">Christina Zeller</data>
  <data key="d0">person</data>
