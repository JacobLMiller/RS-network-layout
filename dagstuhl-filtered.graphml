</node>
<node id="Jan Strejcek">
  <data key="d14">Jan Strejcek</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/37/1716</data>
</node>
<node id="Michael Tautschnig">
  <data key="d14">Michael Tautschnig</data>
  <data key="d0">person</data>
