<node id="Louis-Noël Pouchet">
  <data key="d14">Louis-Noël Pouchet</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/41/5129</data>
</node>
<node id="Barbara Wohlmuth">
  <data key="d14">Barbara Wohlmuth</data>
  <data key="d0">person</data>
