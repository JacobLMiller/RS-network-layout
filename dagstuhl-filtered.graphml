  <data key="d11">data bases / information retrieval; data structures / algorithms / complexity; interdisciplinary; geographic information systems</data>
  <data key="d12">constraint databases; geometric elimination; quantier elimination algorithms; geographic information systems</data>
  <data key="d13"></data>
</node>
