</node>
<node id="Harold Fellermann">
  <data key="d14">Harold Fellermann</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/61/758</data>
</node>
<node id="Marc Hellmuth">
  <data key="d14">Marc Hellmuth</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/59/7705</data>
</node>
<node id="Wim Hordijk">
  <data key="d14">Wim Hordijk</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/44/1479</data>
</node>
<node id="Daniel Merkle">
  <data key="d14">Daniel Merkle</data>
  <data key="d0">person</data>
