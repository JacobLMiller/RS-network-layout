  <data key="d14">David K. Lowenthal</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/l/DavidKLowenthal</data>
</node>
<node id="David Montoya">
  <data key="d14">David Montoya</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/13/3372</data>
</node>
<node id="Nathan Tallent">
