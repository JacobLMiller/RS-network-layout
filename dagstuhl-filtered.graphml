</node>
<node id="Tomohiro I">
  <data key="d14">Tomohiro I</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/95/2224</data>
</node>
<node id="Nicola Prezza">
  <data key="d14">Nicola Prezza</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/121/1143</data>
</node>
<node id="Markus L. Schmid">
  <data key="d14">Markus L. Schmid</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/65/9125</data>
</node>
<node id="Tatiana Starikovskaya">
  <data key="d14">Tatiana Starikovskaya</data>
  <data key="d0">person</data>
