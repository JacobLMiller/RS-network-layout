  <data key="d15">https://dblp.org/pid/10/3748</data>
</node>
<node id="Harald Köstler">
  <data key="d14">Harald Köstler</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/41/5505</data>
</node>
<node id="Christoph H. Lampert">
  <data key="d14">Christoph H. Lampert</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/67/2136</data>
</node>
<node id="Arvid Lundervold">
  <data key="d14">Arvid Lundervold</data>
  <data key="d0">person</data>
