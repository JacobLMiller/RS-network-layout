</node>
<node id="Ian Nabney">
  <data key="d14">Ian Nabney</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/02/1122</data>
</node>
<node id="Jaakko Peltonen">
  <data key="d14">Jaakko Peltonen</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/80/791</data>
</node>
<node id="Leishi Zhang">
  <data key="d14">Leishi Zhang</data>
  <data key="d0">person</data>
