                        Creative Commons BY 3.0 Unported license
                    &lt;/a&gt;
&lt;/div&gt; 
 &lt;div&gt;
&lt;img alt="Copyright" src="https://www.dagstuhl.de/_Resources/Static/Packages/Dagstuhl.Site/Frontend/images/licenses/copy.png?bust=22575bbf" style="width: 1em;"/&gt;

                    Sarah Schulz, Tarek Richard Besold, Pablo Gervás, and Evelyn Gius
                &lt;/div&gt; 
</data>
  <data key="d9">https://muse.jhu.edu/article/844926 N1; https://arxiv.org/abs/1905.05888</data>
  <data key="d10">https://doi.org/10.4230/DagRep.9.4.87</data>
  <data key="d11">artificial intelligence / robotics; multimedia; society / human-computer interaction</data>
  <data key="d12">computational creativity; storytelling; digital humanities; digital literary studies; computational narrativity</data>
