</node>
<node id="Birgit Penzenstadler">
  <data key="d14">Birgit Penzenstadler</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/92/3113</data>
</node>
<node id="Colin Venters">
  <data key="d14">Colin Venters</data>
