</node>
<node id="Yixin Shen">
  <data key="d14">Yixin Shen</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/222/6915-1</data>
</node>
<node id="Maya-Iggy van Hoof">
  <data key="d14">Maya-Iggy van Hoof</data>
