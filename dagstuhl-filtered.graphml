  <data key="d10">https://doi.org/10.4230/DagSemRep.8</data>
  <data key="d11"></data>
  <data key="d12"></data>
  <data key="d13">9210; 9337; 9537; 9737; 99291</data>
</node>
<node id="E.W. Mayr">
  <data key="d14">E.W. Mayr</data>
  <data key="d0">person</data>
  <data key="d15"></data>
</node>
<node id="F. Meyer a.d. Heide">
  <data key="d14">F. Meyer a.d. Heide</data>
  <data key="d0">person</data>
