  <data key="d11">mobile computing; networks; society / human-computer interaction</data>
  <data key="d12">Community Wireless Networks; Mobile Networking; Delay-Tolerant Networking; Ad-hoc Networking; Ownership; Hybrid Communities; Urban Planning; Urban Art</data>
  <data key="d13"></data>
</node>
