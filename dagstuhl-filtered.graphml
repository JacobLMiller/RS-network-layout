  <data key="d12">Curves; homotopy; knot theory; graph drawing</data>
  <data key="d13">19352; 22062; 24072; 26122</data>
</node>
<node id="Benjamin Burton">
  <data key="d14">Benjamin Burton</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/13/2591</data>
</node>
<node id="Hsien-Chih Chang">
  <data key="d14">Hsien-Chih Chang</data>
  <data key="d0">person</data>
  <data key="d15">https://dblp.org/pid/12/9507</data>
</node>
