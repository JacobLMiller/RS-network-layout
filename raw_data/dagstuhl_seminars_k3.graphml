<<<<<<< HEAD
                    Chen-Fu Chien, Hans Ehm, John Fowler, and Lars Mönch
                &lt;/div&gt; 
</data>
      <data key="d14">https://doi.org/10.1109/WSC.2016.7822302; https://www.tandfonline.com/toc/tprs20/56/13?nav=tocList&amp;; http://dx.doi.org/10.1007/978-3-319-45889-2_9</data>
      <data key="d8">https://doi.org/10.4230/DagRep.6.2.28</data>
      <data key="d9">modelling / simulation; optimization / scheduling</data>
      <data key="d10">Modeling; Simulation; Supply Chain Management; Semiconductor Manufacturing</data>
      <data key="d15">1; 1</data>
