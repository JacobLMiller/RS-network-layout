<<<<<<< HEAD
                    Frederik Armknecht, Helena Handschuh, Tetsu Iwata, and Bart Preneel
                &lt;/div&gt; 
</data>
      <data key="d8">https://doi.org/10.4230/DagRep.4.1.1</data>
      <data key="d9">security / cryptology</data>
      <data key="d10">Authenticity; Integrity; Privacy; Hash Functions; Block Ciphers; Provable Security; Cryptanalysis</data>
      <data key="d15">1; 1; 1; 1; 1; 1; 1; 1</data>
      <data key="d11">Authenticity; Integrity; Privacy; Hash Functions; Block Ciphers; Provable Security; Cryptanalysis; security / cryptology</data>
      <data key="d12">Matthias Krause;Daniel J. Bernstein;Stefan Lucks;Eli Biham;Bart Preneel;Serge Vaudenay;Frederik Armknecht;Tanja Lange;Elena Andreeva;Alex Biryukov;Joan Daemen;Orr Dunkelman;Henri Gilbert;Helena Handschuh;Tetsu Iwata;Willi Meier;Florian Mendel;Kaisa Nyberg;Christian Rechberger;Greg Rose;Kenneth G. Paterson;Jean-Philippe Aumasson;Dmitry Khovratovich;John Steinberger;Gilles Van Assche;Martin R. Albrecht;Francois-Xavier Standaert;Andrey Bogdanov;Itai Dinur;Nils Gregor Leander;Yu Sasaki;Jakob Wenzel;Kan Yasuda;Tomer Ashur;Steve Babbage;Céline Blondeau;Carlos Cid;Jian Guo;Pascal Junod;Jooyoung Lee;Gaëtan Leurent;Eik List;Bart Mennink;Nicky Mouha;Thomas Peyrin;Vesselin Velichkov;Qingju Wang</data>
