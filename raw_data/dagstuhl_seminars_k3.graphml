<<<<<<< HEAD
                    Daniel Archambault, Tobias Hoßfeld, and Helen C. Purchase
                &lt;/div&gt; 
</data>
      <data key="d14">http://www.springer.com/de/book/9783319664347; https://www.microsoft.com/en-us/research/publication/information-visualization-evaluation-using-crowdsourcing/; https://www.kuvs.de/wp-content/uploads/2015/12/kuvs-newsletter__2015-12.pdf</data>
      <data key="d8">https://doi.org/10.4230/DagRep.5.11.103</data>
