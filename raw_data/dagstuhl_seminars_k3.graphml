      <data key="d14">https://doi.org/10.1109/IROS.2016.7759307</data>
      <data key="d9">https://doi.org/10.4230/DagRep.5.10.1</data>
      <data key="d10">artificial intelligence / robotics</data>
      <data key="d11">robotics; manipulation; uncertainty; perception; computer vision; range sensing; tactile sensing</data>
