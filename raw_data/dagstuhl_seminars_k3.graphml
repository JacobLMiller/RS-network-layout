      <data key="d14">https://doi.org/10.1145/3349263.3349600</data>
      <data key="d8">https://doi.org/10.4230/DagRep.9.3.111</data>
      <data key="d9">mobile computing; society / human-computer interaction</data>
      <data key="d10">human-computer interaction; automated driving</data>
      <data key="d15">1; 1; 1</data>
      <data key="d11">human-computer interaction; automated driving; mobile computing; society / human-computer interaction</data>
      <data key="d12">Albrecht Schmidt;Susanne Boll;Jürgen Ziegler;Bastian Pfleging;Steven E. Shladover;Ignacio J. Alvarez;Martin Baumann;Linda Ng Boyle;Duncan Brumby;Gary Burnett;Lewis Chuang;Frank Flemisch;Christian P. Janssen;Wendy Ju;Andrew Kun;Roderick McCall;Ingrid Pettersson;Andreas Riener;Maria Rimini-Doering;Christine Sutter;Stephen Brewster;Birsen Donmez;Joanne Harbluk;Josef Krems;Sabine Langlois;Alexander Meschtscherjakov;Nele Rußwinkel;Ronald Schroeter;Jaka Sodnik;Bruce N. Walker;C. Y. David Yang</data>
