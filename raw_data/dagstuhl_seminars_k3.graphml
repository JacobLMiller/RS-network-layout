<<<<<<< HEAD
                    Jeremy Blackburn, Emiliano De Cristofaro, Gianluca Stringhini, Michael Sirivianos, and Thorsten Strufe
                &lt;/div&gt; 
</data>
      <data key="d14">https://arxiv.org/abs/1806.02711</data>
      <data key="d8">https://doi.org/10.4230/DagRep.7.9.47</data>
      <data key="d9">security / cryptology; society / human-computer interaction; world wide web / internet</data>
      <data key="d10">cybersafety; online social networks; security and privacy; legal and ethical issues on the web</data>
      <data key="d15">1</data>
