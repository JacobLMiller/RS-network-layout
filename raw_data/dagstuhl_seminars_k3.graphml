<<<<<<< HEAD
                    Gilles Dowek, Catherine Dubois, Brigitte Pientka, and Florian Rabe
                &lt;/div&gt; 
</data>
      <data key="d8">https://doi.org/10.4230/DagRep.6.10.75</data>
      <data key="d9">semantics / formal methods; verification / logic</data>
      <data key="d10">logics; formal proofs; provers; reusability; interoperability; logical frameworks; proof formats; translation</data>
