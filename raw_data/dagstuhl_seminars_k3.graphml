</data>
      <data key="d14">http://dx.doi.org/10.1007/s00287-014-0833-1; http://dx.doi.org/10.1007/s00287-014-0833-1; http://dx.doi.org/10.1145/2598510.2598541; http://dx.doi.org/10.1145/2669485.2669500; http://dx.doi.org/10.1145/2598510.2598532; http://dx.doi.org/10.1145/2598510.2598604</data>
