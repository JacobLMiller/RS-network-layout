                &lt;/div&gt; 
</data>
      <data key="d14">https://doi.org/10.1145/3349263.3349600</data>
      <data key="d9">https://doi.org/10.4230/DagRep.9.3.111</data>
      <data key="d10">mobile computing; society / human-computer interaction</data>
      <data key="d11">human-computer interaction; automated driving</data>
      <data key="d12">1; 1; 1</data>
