      <data key="d0">event</data>
      <data key="d1">03441</data>
      <data key="d2">Dagstuhl Seminar</data>
      <data key="d3">Cognitive Vision Systems</data>
      <data key="d4">2003-10-26</data>
      <data key="d5">2003-10-31</data>
      <data key="d6">https://www.dagstuhl.de/03441</data>
