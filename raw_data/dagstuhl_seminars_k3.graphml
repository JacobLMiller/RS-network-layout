    <node id="06281">
      <data key="d0">event</data>
      <data key="d1">06281</data>
      <data key="d2">Dagstuhl Seminar</data>
      <data key="d3">The Challenge of Software Verification</data>
      <data key="d4">2006-07-09</data>
      <data key="d5">2006-07-13</data>
      <data key="d6">https://www.dagstuhl.de/06281</data>
      <data key="d14">https://doi.org/10.1007/s00165-007-0059-y</data>
      <data key="d10">programming languages / compiler; sw-engineering semantics / formal methods; verification / logic</data>
