    <node id="Author_Barrett Ens">
      <data key="d0">Author</data>
      <data key="d21">Barrett Ens</data>
    </node>
    <node id="Author_Sarah Goodwin">
      <data key="d0">Author</data>
      <data key="d21">Sarah Goodwin</data>
    </node>
    <node id="Author_Fraser Anderson">
      <data key="d0">Author</data>
      <data key="d21">Fraser Anderson</data>
    </node>
    <node id="Author_Florence Y. Wang">
      <data key="d0">Author</data>
      <data key="d21">Florence Y. Wang</data>
    </node>
    <node id="Author_Samuel Gratzl">
      <data key="d0">Author</data>
      <data key="d21">Samuel Gratzl</data>
    </node>
    <node id="Author_Zac Lucarelli">
      <data key="d0">Author</data>
      <data key="d21">Zac Lucarelli</data>
    </node>
    <node id="Author_Brendan Moyle">
