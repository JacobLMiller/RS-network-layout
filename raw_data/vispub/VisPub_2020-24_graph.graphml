    <node id="Author_Julian Thijssen">
      <data key="d0">Author</data>
      <data key="d21">Julian Thijssen</data>
    </node>
    <node id="Author_Baldur van Lew">
      <data key="d0">Author</data>
      <data key="d21">Baldur van Lew</data>
    </node>
