      <data key="d13">10.1109/tvcg.2016.2598831;10.1109/tvcg.2018.2864812;10.1109/tvcg.2018.2864504;10.1109/tvcg.2017.2744683;10.1109/tvcg.2016.2598831</data>
      <data key="d14">Traffic light detection,representation learning,semantic adversarial learning,model diagnosing,autonomous driving</data>
