    <node id="Paper_2868">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Getting along: composition of visualization paradigms</data>
      <data key="d4">10.1109/infvis.2001.963278</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963278</data>
      <data key="d6">37.0</data>
      <data key="d7">40.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Alan Keahey</data>
      <data key="d11">T.A. Keahey</data>
      <data key="d12">Visual Insights, Inc., USA</data>
      <data key="d13">10.1109/infvis.1997.636786;10.1109/visual.1992.235217;10.1109/visual.1991.175815;10.1109/infvis.1997.636718;10.1109/infvis.1997.636784;10.1109/infvis.1996.559214;10.1109/infvis.1998.729558;10.1109/infvis.1997.636786</data>
      <data key="d14" />
