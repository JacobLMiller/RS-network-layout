    <node id="Paper_1257">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Interactive visualization of multiple query results</data>
      <data key="d4">10.1109/infvis.2001.963287</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963287</data>
      <data key="d6">105.0</data>
      <data key="d7">112.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Susan Havre;Elizabeth G. Hetzler;Kenneth A. Perrine;Elizabeth Jurrus;Nancy Miller</data>
      <data key="d11">S. Havre;E. Hetzler;K. Perrine;E. Jurrus;N. Miller</data>
      <data key="d12">Battelle Pacific Northwest Division, Richland, WA;Battelle Pacific Northwest Division, Richland, WA;Battelle Pacific Northwest Division, Richland, WA;Battelle Pacific Northwest Division, Richland, WA;Battelle Memorial Institute, Columbus, OH</data>
      <data key="d13">10.1109/infvis.1998.729570;10.1109/visual.1998.745302;10.1109/visual.1993.398863;10.1109/infvis.1998.729570</data>
      <data key="d14" />
