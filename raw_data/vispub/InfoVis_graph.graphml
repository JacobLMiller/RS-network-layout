    <node id="Author_Evan M. Peck">
      <data key="d0">Author</data>
      <data key="d21">Evan M. Peck</data>
    </node>
    <node id="Author_Lane T. Harrison">
      <data key="d0">Author</data>
      <data key="d21">Lane T. Harrison</data>
    </node>
    <node id="Author_Daniel Afergan">
      <data key="d0">Author</data>
      <data key="d21">Daniel Afergan</data>
    </node>
    <node id="Author_Holly A. Taylor">
      <data key="d0">Author</data>
      <data key="d21">Holly A. Taylor</data>
