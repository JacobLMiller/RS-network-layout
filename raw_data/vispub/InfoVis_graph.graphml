    <node id="Paper_2092">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Visualization of state transition graphs</data>
      <data key="d4">10.1109/infvis.2001.963281</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963281</data>
      <data key="d6">59.0</data>
      <data key="d7">66.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Frank van Ham;Huub van de Wetering;Jarke J. van Wijk</data>
      <data key="d11">F. van Ham;H. van de Wetering;J.J. van Wijk</data>
      <data key="d12">Department of Mathematics and Computer Science, Eindhovan University of Technology, Eindhoven, Netherlands;Department of Mathematics and Computer Science, Eindhovan University of Technology, Eindhoven, Netherlands;Department of Mathematics and Computer Science, Eindhovan University of Technology, Eindhoven, Netherlands</data>
      <data key="d13">10.1109/infvis.1995.528691;10.1109/infvis.1995.528689;10.1109/infvis.2001.963281</data>
