      <data key="d3">Graphic data display for cardiovascular system</data>
      <data key="d4">10.1109/infvis.2001.963295</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963295</data>
      <data key="d6">163.0</data>
      <data key="d7">166.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">James Agutter;Noah Syroid;Frank Drews;Dwayne R. Westenskow;Julio C. Bermudez;David L. Strayer</data>
      <data key="d11">J. Agutter;N. Syroid;F. Drews;D. Westenskow;J. Bermudez;D. Strayer</data>
      <data key="d12">Graduate School of Architecture, University of Utah, USA;Department of BioEngineering, University of Utah, USA;Department of Psychology, University of Utah, USA;Department of BioEngineering, University of Utah, USA;Graduate School of Architecture, University of Utah, USA;Department of Psychology, University of Utah, USA</data>
      <data key="d13" />
      <data key="d14" />
      <data key="d15">0.0</data>
