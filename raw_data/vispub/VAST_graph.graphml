    <node id="Paper_2939">
      <data key="d0">Paper</data>
      <data key="d1">VAST</data>
      <data key="d2">2011</data>
      <data key="d3">KD-photomap: Exploring photographs in space and time</data>
      <data key="d4">10.1109/vast.2011.6102479</data>
      <data key="d5">http://dx.doi.org/10.1109/VAST.2011.6102479</data>
      <data key="d6">291.0</data>
      <data key="d7">292.0</data>
      <data key="d8">M</data>
      <data key="d9">KD-photomap is a web-based visual analytics system for browsing collections of geotagged Flickr photographs in search of interesting pictures, places, and events. Spatial filtering of the data is performed through zooming, moving or searching along the map. Temporal filtering is possible through defining time windows using interactive histograms and calendar controls. Information about the number and spatiotemporal distribution of photos captured in an explored area is continuously provided using various visual cues.</data>
      <data key="d10">Iulian Peca;Haolin Zhi;Katerina Vrotsou;Natalia V. Andrienko;Gennady L. Andrienko</data>
      <data key="d11">Iulian Peca;Haolin Zhi;Katerina Vrotsou;Natalia Andrienko;Gennady Andrienko</data>
      <data key="d12">University of Bonn and Fraunhofer Institute for Intelligent Analysis and Information Systems (IAIS), Germany;University of Bonn and Fraunhofer Institute for Intelligent Analysis and Information Systems (IAIS), Germany;University of Bonn and Fraunhofer Institute for Intelligent Analysis and Information Systems (IAIS), Germany;University of Bonn and Fraunhofer Institute for Intelligent Analysis and Information Systems (IAIS), Germany;University of Bonn and Fraunhofer Institute for Intelligent Analysis and Information Systems (IAIS), Germany</data>
      <data key="d13">0.1109/tvcg.2008.175;10.1109/vast.2010.5652478</data>
      <data key="d14" />
      <data key="d15">8.0</data>
      <data key="d16">4.0</data>
      <data key="d17">6.0</data>
      <data key="d18">193.0</data>
