    <node id="Author_Won-Dong Jang">
      <data key="d0">Author</data>
      <data key="d21">Won-Dong Jang</data>
    </node>
    <node id="Author_Nam Wook Kim">
      <data key="d0">Author</data>
      <data key="d21">Nam Wook Kim</data>
