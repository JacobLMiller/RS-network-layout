    <node id="Author_Andreas Lamprecht">
      <data key="d0">Author</data>
      <data key="d21">Andreas Lamprecht</data>
    </node>
    <node id="Author_Thorsten Breitkreutz">
      <data key="d0">Author</data>
      <data key="d21">Thorsten Breitkreutz</data>
    </node>
    <node id="Author_Philipp Zimmermann">
      <data key="d0">Author</data>
      <data key="d21">Philipp Zimmermann</data>
    </node>
    <node id="Author_Bastian Goldlücke">
      <data key="d0">Author</data>
      <data key="d21">Bastian Goldlücke</data>
    </node>
