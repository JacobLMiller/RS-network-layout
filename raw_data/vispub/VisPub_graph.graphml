      <data key="d0">Author</data>
      <data key="d21">Lester Kwock</data>
    </node>
    <node id="Author_Yueh Z. Lee">
      <data key="d0">Author</data>
      <data key="d21">Yueh Z. Lee</data>
    </node>
    <node id="Author_Russell M. Taylor II">
      <data key="d0">Author</data>
