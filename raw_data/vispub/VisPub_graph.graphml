    <node id="Paper_2434">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Case study: design and assessment of an enhanced geographic information system for exploration of multivariate health statistics</data>
      <data key="d4">10.1109/infvis.2001.963294</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963294</data>
      <data key="d6">159.0</data>
      <data key="d7">162.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Robert M. Edsall;Alan M. MacEachren;Linda Pickle</data>
      <data key="d11">R.M. Edsall;A.M. MacEachren;L. Pickle</data>
      <data key="d12">Department of Geography, Arizona State University, USA;Department of Geography, Pennsylvania State University, USA;National Cancer Institute, USA</data>
      <data key="d13">10.1109/infvis.1998.729563;10.1109/infvis.1998.729563</data>
      <data key="d14" />
      <data key="d15">46.0</data>
      <data key="d16">9.0</data>
      <data key="d17">5.0</data>
      <data key="d18">131.0</data>
