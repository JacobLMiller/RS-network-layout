    <node id="Paper_1723">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Pixel bar charts: a new technique for visualizing large multi-attribute data sets without aggregation</data>
      <data key="d4">10.1109/infvis.2001.963288</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963288</data>
      <data key="d6">113.0</data>
      <data key="d7">120.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Daniel A. Keim;Ming C. Hao;Julian Ladisch;Meichun Hsu;Umeshwar Dayal</data>
      <data key="d11">D. Keim;M.C. Hao;J. Ladisch;Meichun Hsu;U. Dayal</data>
      <data key="d12">Computer Science Institute, University of Constance, Constance, Germany;Hewlett Packard Laboratories, Palo Alto, CA, USA;Computer Science Institute, University of Constance, Constance, Germany;Hewlett Packard Laboratories, Palo Alto, CA, USA;Hewlett Packard Laboratories, Palo Alto, CA, USA</data>
      <data key="d13">10.1109/visual.1995.485140;10.1109/visual.1993.398870;10.1109/infvis.1999.801867;10.1109/visual.1991.175794;10.1109/visual.1990.146387;10.1109/visual.1990.146402;10.1109/infvis.1995.528690;10.1109/visual.1990.146386;10.1109/visual.1995.485140</data>
      <data key="d14" />
      <data key="d15">82.0</data>
      <data key="d16">19.0</data>
      <data key="d17">19.0</data>
      <data key="d18">457.0</data>
