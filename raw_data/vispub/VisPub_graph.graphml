    <node id="Paper_3133">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2004</data>
      <data key="d3">Exploring and Visualizing the History of InfoVis</data>
      <data key="d4">10.1109/infvis.2004.22</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2004.22</data>
      <data key="d6" />
      <data key="d7" />
      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">Daniel A. Keim;Helmut Barro;Christian Panse;Jörn Schneidewind;Mike Sips</data>
      <data key="d11">D.A. Keim;H. Barro;C. Panse;J. Schneidewind;M. Sips</data>
      <data key="d12">University of Konstanz, Germany;University of Konstanz, Germany;University of Konstanz, Germany;University of Konstanz, Germany;University of Konstanz, Germany</data>
      <data key="d13" />
