    <node id="Paper_2868">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Getting along: composition of visualization paradigms</data>
      <data key="d4">10.1109/infvis.2001.963278</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963278</data>
      <data key="d6">37.0</data>
