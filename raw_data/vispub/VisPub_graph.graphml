      <data key="d21">M. Braun</data>
    </node>
    <node id="Paper_2930">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1991</data>
      <data key="d3">Multimedia environments for scientists</data>
      <data key="d4">10.1109/visual.1991.175827</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1991.175827</data>
      <data key="d6">348.0</data>
      <data key="d7">353.0</data>
      <data key="d8">M</data>
      <data key="d9">This paper addresses the question of how the work of the scientist will change in the new multimedia environments. Scenarios for the process of simulating and analyzing data in such environments are constructed, and some of the underlying models used in their construction are examined.&amp;lt;&amp;lt;ETX&amp;gt;&amp;gt;</data>
      <data key="d10">M.M. Blattner;G. Grinstein;E.P. Glinert;W. Hill;C. Levit;S. Smith</data>
      <data key="d11">M.M. Blattner;G. Grinstein;E.P. Glinert;W. Hill;C. Levit;S. Smith</data>
      <data key="d12">;;;;;</data>
