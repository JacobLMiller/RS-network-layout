    <node id="Paper_3548">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1999</data>
      <data key="d3">Visualization needs more visual design!</data>
      <data key="d4">10.1109/visual.1999.809939</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1999.809939</data>
      <data key="d6">485.0</data>
      <data key="d7">490.0</data>
      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">J. Edward Swan II;Theresa-Marie Rhyne;David H. Laidlaw;Tamara Munzner;Victoria Interrante</data>
      <data key="d11">J.E. Swan</data>
      <data key="d12">Naval Research Laboratory;Lockheed Martin - United States Environmental Protection Agency’s Scientific Visualization Center;Brown University;Stanford University;University of Minnesota</data>
      <data key="d13" />
      <data key="d14" />
