      <data key="d2">1999</data>
      <data key="d3">Automation or interaction: what's best for big data?</data>
      <data key="d4">10.1109/visual.1999.809940</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1999.809940</data>
