    <node id="Paper_328">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1995</data>
      <data key="d3">High Dimensional Brushing for Interactive Exploration of Multivariate Data</data>
      <data key="d4">10.1109/visual.1995.485139</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1995.485139</data>
      <data key="d6">271.0</data>
      <data key="d7" />
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Allen R. Martin;Matthew O. Ward</data>
      <data key="d11">A.R. Martin;M.O. Ward</data>
      <data key="d12">Advanced Graphics Division, Silicon Graphics, Inc., Mountain View, CA, USA;Computer Science Department, Worcester Polytechnic Institute, Worcester, MA, USA</data>
      <data key="d13">10.1109/visual.1990.146386;10.1109/visual.1990.146402;10.1109/visual.1994.346302;10.1109/visual.1990.146386</data>
      <data key="d14" />
