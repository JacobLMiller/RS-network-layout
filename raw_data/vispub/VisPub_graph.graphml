    <node id="Paper_3566">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1996</data>
      <data key="d3">Real-time Accelerators for Volume Rendering</data>
      <data key="d4">10.1109/visual.1996.568160</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1996.568160</data>
      <data key="d6">445.0</data>
      <data key="d7">447.0</data>
      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">Hanspeter Pfister;Günter Knittel;Jürgen Hesser;John C. Goble</data>
      <data key="d11">A. Kaufman;H. Pfister;G. Knittel;J. Hesser;J.C. Goble</data>
      <data key="d12">State University of New York, Stony Brook, USA;Mitsubishi Electric Research Laboratory MERLA, USA;University of Tubingen, Germany;University of Mannheim, Germany;Hewlett Packard Company, USA</data>
      <data key="d13">0.1109/visual.1995.480810</data>
