      <data key="d2">2004</data>
      <data key="d3">Depth Enhanced Panoramas</data>
      <data key="d4">10.1109/visual.2004.22</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.2004.22</data>
      <data key="d6">11.0</data>
