    <node id="Author_Andreas Mathisen">
      <data key="d0">Author</data>
      <data key="d21">Andreas Mathisen</data>
    </node>
    <node id="Author_Roman Rädle">
      <data key="d0">Author</data>
      <data key="d21">Roman Rädle</data>
    </node>
    <node id="Author_Clemens Nylandsted Klokmose">
      <data key="d0">Author</data>
      <data key="d21">Clemens Nylandsted Klokmose</data>
