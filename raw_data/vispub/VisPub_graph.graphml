    <node id="Paper_3529">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">2004</data>
      <data key="d3">Visualization of the Interaction of Multiple Sclerosis Lesions with Adjacent White Matter Fibers Using Streamtubes and Streamsurfaces</data>
      <data key="d4">10.1109/visual.2004.116</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.2004.116</data>
      <data key="d6">29.0</data>
      <data key="d7">29.0</data>
      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">Song Zhang 0004;David H. Laidlaw;Jack Simon;Mark Brown;David Miller</data>
      <data key="d11">Song Zhang;D. Laidlaw;J. Simon;M. Brown;D. Miller</data>
      <data key="d12">Brown University, USA;Brown University, USA;University of Colorado, Health Sciences Center, USA;University of Colorado, Health Sciences Center, USA;University of Colorado, Health Sciences Center, USA</data>
      <data key="d13" />
      <data key="d14" />
