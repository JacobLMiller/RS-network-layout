    <node id="Author_Enrico Bertini">
      <data key="d0">Author</data>
      <data key="d21">Enrico Bertini</data>
    </node>
    <node id="Author_Andrada Tatu">
      <data key="d0">Author</data>
      <data key="d21">Andrada Tatu</data>
