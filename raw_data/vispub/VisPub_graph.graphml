      <data key="d0">Author</data>
      <data key="d21">Sean A. Stephens</data>
    </node>
    <node id="Author_Carlos Scheidegger">
      <data key="d0">Author</data>
      <data key="d21">Carlos Scheidegger</data>
    </node>
