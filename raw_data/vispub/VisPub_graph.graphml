      <data key="d0">Author</data>
      <data key="d21">Ralf Kähler</data>
    </node>
    <node id="Author_Oliver Hahn 0002">
      <data key="d0">Author</data>
      <data key="d21">Oliver Hahn 0002</data>
    </node>
    <node id="Author_Tom Abel">
      <data key="d0">Author</data>
      <data key="d21">Tom Abel</data>
