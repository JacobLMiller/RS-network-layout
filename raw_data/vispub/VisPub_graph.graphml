    <node id="Paper_3172">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1998</data>
      <data key="d3">Key Problems and Thorny Issues in Multidimensional Visualization</data>
      <data key="d4">10.1109/visual.1998.745354</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1998.745354</data>
      <data key="d6">505.0</data>
