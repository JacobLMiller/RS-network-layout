    <node id="Paper_128">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Visualizing time-series on spirals</data>
      <data key="d4">10.1109/infvis.2001.963273</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963273</data>
      <data key="d6">7.0</data>
      <data key="d7">13.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Marc Weber;Marc Alexa;Wolfgang Müller 0004</data>
      <data key="d11">M. Weber;M. Alexa;W. Muller</data>
      <data key="d12">Crcp Technische Universität Darmstadt, Germany;Crcp Technische Universität Darmstadt, Germany;Crcp Technische Universität Darmstadt, Germany</data>
      <data key="d13">10.1109/visual.1991.175794;10.1109/infvis.2000.885098;10.1109/infvis.1995.528685;10.1109/visual.1991.175794</data>
      <data key="d14">Information Visualization, Graph Drawing, Visualization of Time-Series Data, Data Mining </data>
      <data key="d15">517.0</data>
      <data key="d16">135.0</data>
