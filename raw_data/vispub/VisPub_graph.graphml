    <node id="Author_Marcel Wunderlich">
      <data key="d0">Author</data>
      <data key="d21">Marcel Wunderlich</data>
    </node>
    <node id="Author_Markus Höhn">
      <data key="d0">Author</data>
      <data key="d21">Markus Höhn</data>
    </node>
    <node id="Author_M. Lieser">
      <data key="d0">Author</data>
      <data key="d21">M. Lieser</data>
    </node>
    <node id="Author_A. Dalpke">
      <data key="d0">Author</data>
