    <node id="Paper_814">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Botanical visualization of huge hierarchies</data>
      <data key="d4">10.1109/infvis.2001.963285</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963285</data>
      <data key="d6">87.0</data>
