      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">William Chao;Daniel Ha;Kevin Ho;Linda T. Kaastra;Minjung Kim;Andrew Wade;Brian D. Fisher</data>
      <data key="d11">William Chao;Daniel Ha;Kevin Ho;Linda Kaastra;Minjung Kim;Andrew Wade;Brian Fisher</data>
      <data key="d12">Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada;Simon Fraser University, SIAT and University of British Columbia, MAGIC, Canada</data>
