    <node id="Paper_3350">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">2003</data>
      <data key="d3">Do I really see a bone?</data>
      <data key="d4">10.1109/visual.2003.1250429</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.2003.1250429</data>
      <data key="d6">615.0</data>
      <data key="d7">617.0</data>
      <data key="d8">M</data>
      <data key="d9" />
      <data key="d10">Raghu Machiraju;Chris R. Johnson 0001;Terry S. Yoo;Roger Crawfis;David S. Ebert;Don Stredney</data>
      <data key="d11">R. Machiraju;C. Johnson;T. Yoo;R. Crawfis;D. Ebert;D. Stredney</data>
