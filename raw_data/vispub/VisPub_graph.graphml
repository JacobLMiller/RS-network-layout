      <data key="d20" />
    </node>
    <node id="Author_Pierre-Yves Koenig">
      <data key="d0">Author</data>
      <data key="d21">Pierre-Yves Koenig</data>
    </node>
    <node id="Author_Faraz Zaidi">
      <data key="d0">Author</data>
      <data key="d21">Faraz Zaidi</data>
    </node>
    <node id="Author_Frédéric Gilbert 0001">
      <data key="d0">Author</data>
      <data key="d21">Frédéric Gilbert 0001</data>
    </node>
    <node id="Author_Trung-Tien Phan-Quang">
      <data key="d0">Author</data>
      <data key="d21">Trung-Tien Phan-Quang</data>
