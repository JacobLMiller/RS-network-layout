    <node id="Author_Pedro Hermosilla">
      <data key="d0">Author</data>
      <data key="d21">Pedro Hermosilla</data>
    </node>
    <node id="Author_Jorge Estrada">
      <data key="d0">Author</data>
      <data key="d21">Jorge Estrada</data>
    </node>
    <node id="Author_Victor Guallar">
      <data key="d0">Author</data>
      <data key="d21">Victor Guallar</data>
    </node>
    <node id="Author_Àlvar Vinacua">
      <data key="d0">Author</data>
      <data key="d21">Àlvar Vinacua</data>
