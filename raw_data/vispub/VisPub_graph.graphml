      <data key="d0">Author</data>
      <data key="d21">John A. Greenfield</data>
    </node>
    <node id="Author_Eric T. Stanton">
      <data key="d0">Author</data>
      <data key="d21">Eric T. Stanton</data>
    </node>
    <node id="Author_Lisa G. Ice">
      <data key="d0">Author</data>
      <data key="d21">Lisa G. Ice</data>
