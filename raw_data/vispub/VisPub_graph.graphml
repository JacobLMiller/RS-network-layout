    <node id="Paper_914">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Semantic depth of field</data>
      <data key="d4">10.1109/infvis.2001.963286</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963286</data>
      <data key="d6">97.0</data>
      <data key="d7">104.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">Robert Kosara;Silvia Miksch;Helwig Hauser</data>
      <data key="d11">R. Kosara;S. Miksch;H. Hauser</data>
      <data key="d12">University of Technology, Vienna, Austria;University of Technology, Vienna, Austria;VRVis Research Center, Austria</data>
      <data key="d13">10.1109/visual.2000.885698;10.1109/infvis.2000.885088</data>
      <data key="d14">Depth of Field, Focus and Context, Information Visualization</data>
      <data key="d15">204.0</data>
      <data key="d16">39.0</data>
      <data key="d17">26.0</data>
      <data key="d18">255.0</data>
