      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">1997</data>
      <data key="d3">Terascale Visualization: Approaches, Pitfalls And Issues</data>
      <data key="d4">10.1109/visual.1997.663932</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.1997.663932</data>
