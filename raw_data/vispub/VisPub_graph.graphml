    <node id="Paper_2532">
      <data key="d0">Paper</data>
      <data key="d1">InfoVis</data>
      <data key="d2">2001</data>
      <data key="d3">Graph sketches</data>
      <data key="d4">10.1109/infvis.2001.963282</data>
      <data key="d5">http://dx.doi.org/10.1109/INFVIS.2001.963282</data>
      <data key="d6">67.0</data>
      <data key="d7">70.0</data>
      <data key="d8">C</data>
      <data key="d9" />
      <data key="d10">James Abello;Irene Finocchi;Jeffrey L. Korn</data>
      <data key="d11">J. Abello;I. Finocchi;J. Korn</data>
      <data key="d12">Information Visualization Research, AT&amp;T Labs-Research, USA;Computer Science Department, University of Rome La Sapienza;Information Visualization Research, AT&amp;T Labs-Research, USA</data>
      <data key="d13">10.1109/infvis.2000.885089;10.1109/infvis.2000.885089</data>
