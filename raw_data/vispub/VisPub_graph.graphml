      <data key="d12">Visual Insights, Inc., USA</data>
      <data key="d13">10.1109/infvis.1997.636786;10.1109/visual.1992.235217;10.1109/visual.1991.175815;10.1109/infvis.1997.636718;10.1109/infvis.1997.636784;10.1109/infvis.1996.559214;10.1109/infvis.1998.729558;10.1109/infvis.1997.636786</data>
      <data key="d14" />
