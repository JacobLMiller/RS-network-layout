    <node id="Paper_3534">
      <data key="d0">Paper</data>
      <data key="d1">Vis</data>
      <data key="d2">2003</data>
      <data key="d3">The visualization market: open source vs. commercial approaches</data>
      <data key="d4">10.1109/visual.2003.1250350</data>
      <data key="d5">http://dx.doi.org/10.1109/VISUAL.2003.1250350</data>
      <data key="d6">21.0</data>
