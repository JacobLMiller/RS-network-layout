      <data key="d9" />
      <data key="d10">Ernst Kleiberg;Huub van de Wetering;Jarke J. van Wijk</data>
      <data key="d11">E. Kleiberg;H. van de Wetering;J.J. van Wijk</data>
      <data key="d12">Department of Mathematics and Computer Science, Eindhovan University of Technology, Netherlands;Department of Mathematics and Computer Science, Eindhovan University of Technology, Netherlands;Department of Mathematics and Computer Science, Eindhovan University of Technology, Netherlands</data>
